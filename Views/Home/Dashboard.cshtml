@{
    ViewData["Title"] = "Dashboard";

    int totalDocumentos = ViewBag.TotalDocumentos ?? 0;
    int pendentes = ViewBag.Pendentes ?? 0;
    int feitos = ViewBag.Feitos ?? 0;
    int cancelados = ViewBag.Cancelados ?? 0;
    decimal valor = (decimal)(ViewBag.ValorFeito ?? 0);

    string periodo = ViewBag.Periodo as string ?? "mes";
    DateTime periodoInicio = (DateTime)ViewBag.PeriodoInicio;
    DateTime periodoFim = (DateTime)ViewBag.PeriodoFim;
}

@section Styles {
    <style>
        /* =====================================================
               DASHBOARD — cards e tabela
           ===================================================== */

        .db-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .db-header-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .db-header-icon {
            width: 48px;
            height: 48px;
            background: #ede9fe;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .db-header-icon svg {
                width: 26px;
                height: 26px;
                stroke: #7c3aed;
            }

        .db-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
            line-height: 1.2;
        }

        .db-date {
            font-size: 13px;
            color: #94a3b8;
            font-weight: 500;
        }

        /* ----- Seletor de período (Semana / Mês / Ano) ----- */
        .db-periodo {
            display: flex;
            gap: 4px;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 24px;
        }

        .db-periodo-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 44px; /* alvo de toque confortável no celular */
            padding: 8px 4px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            color: #64748b;
            text-decoration: none;
            white-space: nowrap;
            transition: background .15s ease, color .15s ease, box-shadow .15s ease;
        }

            .db-periodo-btn.ativo {
                background: #7c3aed;
                color: #fff;
                box-shadow: 0 2px 8px rgba(124,58,237,.3);
            }

            .db-periodo-btn:not(.ativo):hover {
                background: #e2e8f0;
                color: #334155;
            }

        /* ----- Grid de cards ----- */
        .db-grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .db-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        @@media (max-width: 900px) {
            .db-grid-4 {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 520px) {
            .db-grid-4 {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .db-grid-2 {
                grid-template-columns: 1fr;
                gap: 12px;
            }
        }

        /* ----- Card base ----- */
        .db-card {
            background: #fff;
            border-radius: 14px;
            padding: 22px 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
            text-decoration: none;
            display: block;
            transition: transform .15s ease, box-shadow .15s ease;
            position: relative;
            overflow: hidden;
        }

            .db-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 12px rgba(0,0,0,.1), 0 8px 28px rgba(0,0,0,.07);
            }

            /* Faixa colorida no topo */
            .db-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--card-accent);
            }

        .db-card-inner {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .db-card-body {
            flex: 1;
        }

        .db-card-number {
            font-size: 36px;
            font-weight: 800;
            line-height: 1;
            color: var(--card-accent);
            letter-spacing: -1px;
        }

        .db-card-label {
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
            margin-top: 4px;
        }

        .db-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: var(--card-bg-icon);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .db-card-icon svg {
                width: 22px;
                height: 22px;
                stroke: var(--card-accent);
            }

        /* Variantes de cor */
        .db-card.azul {
            --card-accent: #2563eb;
            --card-bg-icon: #eff6ff;
        }

        .db-card.amarelo {
            --card-accent: #d97706;
            --card-bg-icon: #fffbeb;
        }

        .db-card.verde {
            --card-accent: #16a34a;
            --card-bg-icon: #f0fdf4;
        }

        .db-card.vermelho {
            --card-accent: #dc2626;
            --card-bg-icon: #fef2f2;
        }

        .db-card.roxo {
            --card-accent: #7c3aed;
            --card-bg-icon: #ede9fe;
        }

        .db-card.teal {
            --card-accent: #0d9488;
            --card-bg-icon: #f0fdfa;
        }

        /* Card wide (2 colunas) — layout horizontal */
        .db-card-wide .db-card-inner {
            align-items: center;
        }

        .db-card-wide .db-card-number {
            font-size: 32px;
        }
    </style>
}

@* ===== CABEÇALHO ===== *@
<div class="db-header">
    <div class="db-header-left">
        <div class="db-header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
            </svg>
        </div>
        <h1 class="db-header">Dashboard</h1>
    </div>

    <span class="db-date">
        @periodoInicio.ToString("dd/MM/yyyy") – @periodoFim.ToString("dd/MM/yyyy")
    </span>
</div>

@* ===== SELETOR DE PERÍODO (Semana / Mês / Ano) ===== *@
<nav class="db-periodo" aria-label="Selecionar período">
    <a class="db-periodo-btn @(periodo == "semana" ? "ativo" : "")"
       href="@Url.Action("Dashboard", "Home", new { periodo = "semana" })">Semana</a>
    <a class="db-periodo-btn @(periodo == "mes" ? "ativo" : "")"
       href="@Url.Action("Dashboard", "Home", new { periodo = "mes" })">Mês</a>
    <a class="db-periodo-btn @(periodo == "ano" ? "ativo" : "")"
       href="@Url.Action("Dashboard", "Home", new { periodo = "ano" })">Ano</a>
</nav>

@* ===== CARDS DE DOCUMENTOS (4 colunas) ===== *@
<div class="db-grid-4">

    <a href="@Url.Action("Historico", "Documentos", new { status = "Pendente" })"
       class="db-card amarelo">
        <div class="db-card-inner">
            <div class="db-card-body">
                <div class="db-card-number">@pendentes</div>
                <div class="db-card-label">Pendentes</div>
            </div>
            <div class="db-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
            </div>
        </div>
    </a>

    <a href="@Url.Action("Historico", "Documentos", new { status = "Feito" })"
       class="db-card verde">
        <div class="db-card-inner">
            <div class="db-card-body">
                <div class="db-card-number">@feitos</div>
                <div class="db-card-label">Feitos</div>
            </div>
            <div class="db-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
        </div>
    </a>

    <a href="@Url.Action("Historico", "Documentos", new { status = "Cancelado" })"
       class="db-card vermelho">
        <div class="db-card-inner">
            <div class="db-card-body">
                <div class="db-card-number">@cancelados</div>
                <div class="db-card-label">Cancelados</div>
            </div>
            <div class="db-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="15" y1="9" x2="9" y2="15" />
                    <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
            </div>
        </div>
    </a>

    <a href="@Url.Action("Historico", "Documentos")"
       class="db-card azul">
        <div class="db-card-inner">
            <div class="db-card-body">
                <div class="db-card-number">@totalDocumentos</div>
                <div class="db-card-label">Total</div>
            </div>
            <div class="db-card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
        </div>
    </a>

</div>

@* ===== CARD FINANCEIRO ===== *@
<div class="db-grid-2">

    <a href="@Url.Action("Historico", "Documentos", new { status = "Feito" })"
       class="db-card teal db-card-wide">
        <div class="db-card-inner">
            <div class="db-card-icon" style="width:52px;height:52px;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="width:26px;height:26px;">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
            <div class="db-card-body" style="margin-left:16px;">
                <div class="db-card-number" style="font-size:26px;">
                    R$ @valor.ToString("N2")
                </div>
                <div class="db-card-label">
                    @feitos documento(s) feito(s) — @(periodo == "semana" ? "na semana" : periodo == "mes" ? "no mês" : "no ano")
                </div>
            </div>
        </div>    </a>

</div>