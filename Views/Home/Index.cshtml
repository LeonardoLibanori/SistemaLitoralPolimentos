@{
    ViewData["Title"] = "Início";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Litoral Polimentos - Documentos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

            /* Neutraliza o container do Bootstrap */
            div.container {
    max-width: 520px !important;
    padding: 0 20px !important;
}

            :root {
              --stone: #1a1714;
              --marble: #f5f0eb;
              --gold: #b8954a;
              --gold-light: #d4b06a;
              --granite: #4a4540;
              --cream: #faf7f4;
              --shadow: rgba(26,23,20,0.15);
            }

            body {
              font-family: 'DM Sans', sans-serif;
              background: var(--cream);
              min-height: 100vh;
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              padding: 40px 20px;
              background-image:
                radial-gradient(ellipse at 20% 20%, rgba(184,149,74,0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 80%, rgba(74,69,64,0.08) 0%, transparent 50%);
            }

            /* Textura sutil de fundo */
            body::before {
              content: '';
              position: fixed;
              inset: 0;
              background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23b8954a' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
              pointer-events: none;
              z-index: 0;
            }

            .container {
              position: relative;
              z-index: 1;
              width: 100%;
              max-width: 520px;
            }

            /* Header */
            .header {
              text-align: center;
              margin-bottom: 48px;
              animation: fadeDown 0.7s ease both;
            }

            .logo-wrap {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              width: 110px;
              height: 110px;
              background: white;
              border-radius: 50%;
              box-shadow: 0 4px 30px var(--shadow), 0 0 0 6px var(--marble), 0 0 0 8px var(--gold);
              margin-bottom: 24px;
              overflow: hidden;
            }

            .logo-wrap img {
              width: 90px;
              height: 90px;
              object-fit: contain;
            }

            .brand-name {
              font-family: 'Playfair Display', serif;
              font-size: clamp(26px, 6vw, 36px);
              font-weight: 900;
              color: var(--stone);
              letter-spacing: -0.5px;
              line-height: 1.1;
            }

            .brand-sub {
              font-size: 13px;
              font-weight: 300;
              color: var(--gold);
              letter-spacing: 4px;
              text-transform: uppercase;
              margin-top: 6px;
            }

            .divider {
              width: 60px;
              height: 2px;
              background: linear-gradient(90deg, transparent, var(--gold), transparent);
              margin: 16px auto 0;
            }

            /* Menu de documentos */
            .menu-title {
              font-size: 11px;
              font-weight: 500;
              letter-spacing: 3px;
              text-transform: uppercase;
              color: var(--granite);
              text-align: center;
              margin-bottom: 20px;
            }

            .menu-grid {
              display: flex;
              flex-direction: column;
              gap: 14px;
            }

            .doc-btn {
              display: flex;
              align-items: center;
              gap: 20px;
              padding: 22px 28px;
              background: white;
              border: 1.5px solid rgba(184,149,74,0.2);
              border-radius: 16px;
              text-decoration: none;
              cursor: pointer;
              transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
              box-shadow: 0 2px 12px var(--shadow);
              animation: fadeUp 0.6s ease both;
              position: relative;
              overflow: hidden;
            }

            .doc-btn::before {
              content: '';
              position: absolute;
              left: 0; top: 0; bottom: 0;
              width: 4px;
              background: var(--gold);
              border-radius: 4px 0 0 4px;
              transform: scaleY(0);
              transition: transform 0.3s ease;
            }

            .doc-btn:hover {
              transform: translateX(6px) scale(1.01);
              border-color: var(--gold);
              box-shadow: 0 8px 32px rgba(184,149,74,0.2);
            }

            .doc-btn:hover::before {
              transform: scaleY(1);
            }

            .doc-btn:nth-child(1) { animation-delay: 0.1s; }
            .doc-btn:nth-child(2) { animation-delay: 0.2s; }
            .doc-btn:nth-child(3) { animation-delay: 0.3s; }

            .btn-icon {
              width: 52px;
              height: 52px;
              border-radius: 12px;
              display: flex;
              align-items: center;
              justify-content: center;
              font-size: 24px;
              flex-shrink: 0;
            }

            .icon-orc  { background: rgba(184,149,74,0.12); }
            .icon-rec  { background: rgba(74,149,74,0.12); }
            .icon-con  { background: rgba(74,74,149,0.12); }

            .btn-text { flex: 1; }
            .btn-label {
              font-family: 'Playfair Display', serif;
              font-size: 18px;
              font-weight: 700;
              color: var(--stone);
              display: block;
            }
            .btn-desc {
              font-size: 12px;
              color: var(--granite);
              margin-top: 2px;
              font-weight: 300;
            }

            .btn-arrow {
              font-size: 20px;
              color: var(--gold);
              opacity: 0;
              transform: translateX(-8px);
              transition: all 0.3s ease;
            }
            .doc-btn:hover .btn-arrow {
              opacity: 1;
              transform: translateX(0);
            }

            /* Footer */
            .footer {
              text-align: center;
              margin-top: 40px;
              font-size: 11px;
              color: #aaa;
              letter-spacing: 1px;
              animation: fadeUp 0.8s 0.4s ease both;
            }

            @@media (max-width: 480px) {
              body { padding: 30px 16px; }
              .logo-wrap { width: 90px; height: 90px; }
              .logo-wrap img { width: 72px; height: 72px; }
              .brand-name { font-size: 24px; }
              .doc-btn { padding: 18px 20px; gap: 14px; }
              .btn-icon { width: 44px; height: 44px; font-size: 20px; }
              .btn-label { font-size: 16px; }
            }

            @@keyframes fadeDown {
              from { opacity: 0; transform: translateY(-20px); }
              to   { opacity: 1; transform: translateY(0); }
            }
            @@keyframes fadeUp {
              from { opacity: 0; transform: translateY(20px); }
              to   { opacity: 1; transform: translateY(0); }
            }
    </style>
</head>
<body>
    <div class="container" id="menuPrincipal">
    <div class="header">
            <div class="logo-wrap">
                <img id="logoImg" src="" alt="Litoral Polimentos">
            </div>
            <div class="brand-name">Litoral Polimentos</div>
            <div class="brand-sub">Mármores &amp; Granitos</div>
            <div class="divider"></div>
        </div>

        <p class="menu-title">Selecione o documento</p>

        <div class="menu-grid">
            <a href="#" onclick="irPara('orcamento')" class="doc-btn">
                <div class="btn-icon icon-orc">📋</div>
                <div class="btn-text">
                    <span class="btn-label">Orçamento</span>
                    <span class="btn-desc">Gerar proposta de serviço para o cliente</span>
                </div>
                <span class="btn-arrow">→</span>
            </a>

            <a href="#" onclick="irPara('recibo')" class="doc-btn">
                <div class="btn-icon icon-rec">🧾</div>
                <div class="btn-text">
                    <span class="btn-label">Recibo</span>
                    <span class="btn-desc">Emitir recibo de pagamento recebido</span>
                </div>
                <span class="btn-arrow">→</span>
            </a>

           <a href="#" onclick="irPara('contrato')" class="doc-btn">
                <div class="btn-icon icon-con">📄</div>
                <div class="btn-text">
                    <span class="btn-label">Contrato</span>
                    <span class="btn-desc">Formalizar prestação de serviços</span>
                </div>
                <span class="btn-arrow">→</span>
            </a>
        </div>
    </div>

    <div id="secao-orcamento" style="display:none">
        @await Html.PartialAsync("_Orcamento")
    </div>
    <div id="secao-recibo" style="display:none">
        @await Html.PartialAsync("_Recibo")
    </div>
    <div id="secao-contrato" style="display:none">
        @await Html.PartialAsync("_Contrato")
    </div>

    <script>
      document.getElementById('logoImg').src = '/icon-192.png';

     function irPara(secao) {
    // Esconde o menu
    document.getElementById('menuPrincipal').style.display = 'none';

    // Mostra o wrapper da seção
    const el = document.getElementById('secao-' + secao);
    el.style.display = 'block';

    // Mostra o div interno da partial (que começa display:none)
    const mapa = {
        'orcamento': 'paginaOrcamento',
        'recibo': 'paginaRecibo',
        'contrato': 'paginaContrato'
    };
    const interno = document.getElementById(mapa[secao]);
    if (interno) interno.style.display = 'block';

    // Ajusta o body
    document.body.style.display = 'block';
    document.body.style.alignItems = 'unset';
    document.body.style.justifyContent = 'unset';
    document.body.style.padding = '0';

    window.scrollTo(0, 0);
}
 
    </script>
</body>
</html>