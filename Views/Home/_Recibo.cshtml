<!-- RECIBO -->
<div id="paginaRecibo" style="display:none">
    <div class="caixa logo-titulo">
        <img src="" id="logoRecibo">
        <div class="w-100 text-center">
            <div class="titulo-principal">LITORAL POLIMENTOS</div>
            <div class="titulo-secundario">MÁRMORES E GRANITOS</div>
            <div style="font-size:20px; font-weight:bold; margin-top:25px;">RECIBO</div>
        </div>
    </div>

    <div class="caixa">
       
        <label>Nome do Cliente:</label>
        <input id="r_cliente" placeholder="Digite o nome do cliente">


        <label>Tipo de Documento:</label>
        <select id="r_tipo_doc" onchange="atualizarLabelDoc()">
            <option value="cpf">CPF</option>
            <option value="cnpj">CNPJ</option>
        </select>

        <label id="label_doc">CPF:</label>
        <input id="r_cpf" placeholder="Digite o documento" maxlength="18" oninput="mascararDocumento()">

        <label>Endereço:</label>
        <input id="r_endereco" placeholder="Digite o endereço">
        <label>Serviço Prestado:</label>
        <textarea id="r_servico" placeholder="Descreva o serviço prestado"></textarea>
        <label>Valor (R$):</label>
        <input id="r_valor" placeholder="R$ 0,00">
        <label>Forma de Pagamento:</label>
        <select id="r_pagamento">
            <option value="50% do valor no início do serviço e 50% no término">50% no início e 50% no término</option>
            <option value="À vista">À vista</option>
            <option value="outro">Outro (especificar abaixo)</option>
        </select>
        <textarea id="r_formaOutro" style="display:none;" placeholder="Especifique a forma de pagamento"></textarea>
    </div>

    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:24px;">
        <button id="btnPdfRecibo" style="display:flex;align-items:center;justify-content:center;gap:8px;width:220px;padding:11px 0;background:#2563eb;color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            Gerar PDF
        </button>
        <button id="btnShareRecibo" style="display:none;align-items:center;justify-content:center;gap:8px;width:220px;padding:11px 0;background:#16a34a;color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.63 19a19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 3.12 4.18 2 2 0 0 1 5.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L9.91 9.91a16 16 0 0 0 6 6l.46-.46a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 23 18z" /></svg>
            Compartilhar
        </button>
        <button onclick="voltarMenu()" style="display:flex;align-items:center;justify-content:center;gap:8px;width:220px;padding:11px 0;background:transparent;color:#64748b;border:1px solid #e2e8f0;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;">
            ← Voltar
        </button>
    </div>
</div>
