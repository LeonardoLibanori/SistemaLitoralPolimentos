@{
    ViewData["Title"] = "Histórico de Documentos";
}

@section Styles {
    <style>
        .tabela-wrapper {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .tabela-wrapper table {
            min-width: 480px;
        }
        .col-servico {
            max-width: 110px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .abas-container {
            display: flex;
            gap: 0;
            border-bottom: 3px solid #e0e0e0;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            flex-wrap: nowrap;
            margin-bottom: 25px;
        }
        .aba-btn {
            border: none;
            padding: 10px 16px;
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            background: transparent;
            cursor: pointer;
            text-decoration: none;
        }
        .filtros-grid {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
    </style>
}

<div class="caixa">
    <div class="titulo-principal">DOCUMENTOS</div>

    <div style="margin-bottom: 20px;">
        <button onclick="voltarMenu()" class="btn btn-secondary" style="width:100%;">Voltar ao Menu</button>
    </div>

    <!-- Filtros -->
    <div style="background: linear-gradient(135deg, #f5f5f5, #e9ecef); padding: 20px; border-radius: 8px; margin-bottom: 25px;">
        <div class="filtros-grid">
            <div>
                <label style="font-weight:600;color:#333;margin-bottom:6px;display:block;"><strong>Tipo de Documento:</strong></label>
                <select id="filtroTipo" class="form-control" onchange="atualizarHistorico()">
                    <option value="">Todos</option>
                    <option value="orcamentos">Orçamento</option>
                    <option value="recibos">Recibo</option>
                    <option value="contratos">Contrato</option>
                </select>
            </div>
            <div>
                <label style="font-weight:600;color:#333;margin-bottom:6px;display:block;"><strong>Buscar por Nome:</strong></label>
                <input type="text" id="buscaNome" class="form-control" placeholder="Digite o nome do cliente..." onkeyup="atualizarHistorico()">
            </div>
            <div>
                <label style="font-weight:600;color:#333;margin-bottom:6px;display:block;"><strong>Buscar por Data:</strong></label>
                <input type="date" id="buscaData" class="form-control" onchange="atualizarHistorico()">
            </div>
        </div>
    </div>

    <!-- Abas -->
    <div class="abas-container">
        <button class="aba-btn" id="abaOrcamentos" onclick="mostrarAba('orcamentos')" style="color:#007bff;border-bottom:3px solid #007bff;margin-bottom:-3px;">
            📊 Orçamentos
        </button>
        <button class="aba-btn" id="abaRecibos" onclick="mostrarAba('recibos')" style="color:#6c757d;">
            📋 Recibos
        </button>
        <button class="aba-btn" id="abaContratos" onclick="mostrarAba('contratos')" style="color:#6c757d;">
            📄 Contratos
        </button>
    </div>

    <!-- Tabela Orçamentos -->
    <div id="tabOrcamentos" style="margin-bottom:30px;">
        <h4 style="color:#007bff;font-weight:bold;border-bottom:2px solid #007bff;padding-bottom:10px;">Orçamentos Registrados</h4>
        <div class="tabela-wrapper">
            <table class="table table-striped table-hover">
                <thead style="background:#007bff;color:white;">
                    <tr>
                        <th>Cliente</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Serviço</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="corpoOrcamentos">
                    <tr><td colspan="5" style="text-align:center;color:#999;">Nenhum orçamento registrado</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tabela Recibos -->
    <div id="tabRecibos" style="display:none;margin-bottom:30px;">
        <h4 style="color:#28a745;font-weight:bold;border-bottom:2px solid #28a745;padding-bottom:10px;">Recibos Registrados</h4>
        <div class="tabela-wrapper">
            <table class="table table-striped table-hover">
                <thead style="background:#28a745;color:white;">
                    <tr>
                        <th>Cliente</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Serviço</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="corpoRecibos">
                    <tr><td colspan="5" style="text-align:center;color:#999;">Nenhum recibo registrado</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tabela Contratos -->
    <div id="tabContratos" style="display:none;margin-bottom:30px;">
        <h4 style="color:#e6a800;font-weight:bold;border-bottom:2px solid #e6a800;padding-bottom:10px;">Contratos Registrados</h4>
        <div class="tabela-wrapper">
            <table class="table table-striped table-hover">
                <thead style="background:#ffc107;color:black;">
                    <tr>
                        <th>Contratante</th>
                        <th>Valor</th>
                        <th>Data</th>
                        <th>Serviço</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="corpoContratos">
                    <tr><td colspan="5" style="text-align:center;color:#999;">Nenhum contrato registrado</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Limpar Histórico -->
    <div style="text-align:center;margin-top:20px;">
        <button class="btn btn-danger" onclick="limparHistorico()" style="width:100%;padding:14px;font-size:16px;">
            🗑️ Limpar Histórico Completo
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            atualizarHistorico();
        });
    </script>
}
